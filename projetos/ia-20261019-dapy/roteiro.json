        { "tipo": "tag", "texto": "PRÓXIMA PALAVRA", "icone": "alvo", "cor": "azul", "em": "próxima", "posicao": "meio" }
      ]
    },
    {
      "id": "promessa",
      "texto": "Nesta aula você vai aprender três coisas: como o modelo prevê o texto, o que é o Transformer, e como ele é treinado.",
