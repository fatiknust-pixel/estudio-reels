    {
      "id": "final",
      "texto": "Quiz: o que um LLM faz a cada passo? Um, busca uma resposta pronta. Dois, prevê o próximo token. Pensou? É o dois. Na próxima aula: tokens e janela de contexto.",
      "elementos": [
        { "tipo": "enquete", "pergunta": "O QUE UM LLM FAZ A CADA PASSO?", "opcoes": ["1 · BUSCA RESPOSTA PRONTA", "2 · PREVÊ O PRÓXIMO TOKEN"], "em": 0, "posicao": "alto" },
        { "tipo": "carimbo", "texto": "É O 2!", "cor": "verde", "em": "dois." },
