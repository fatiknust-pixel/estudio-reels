    {
      "id": "conceito",
      "texto": "Um LLM, ou modelo de linguagem grande, faz uma tarefa só: prever o próximo token. Token é um pedaço de texto, como uma palavra ou parte dela. Ele calcula as chances do próximo pedaço, escolhe um, e repete.",
      "elementos": [
        { "tipo": "titulo", "texto": "PREVER O PRÓXIMO TOKEN", "em": 0, "posicao": "topo" },
        { "tipo": "definicao", "palavra": "LLM", "significado": "Large Language Model: modelo de linguagem grande", "em": "LLM,", "posicao": "alto" },
        { "tipo": "definicao", "palavra": "TOKEN", "significado": "pedaço de texto: palavra ou parte dela", "em": "Token", "posicao": "alto" },
        { "tipo": "mapa", "de": "TEXTO ATÉ AGORA", "para": "PRÓXIMO TOKEN", "legenda": "escolhe e repete", "em": "calcula", "posicao": "meio" },
        { "tipo": "carimbo", "texto": "REPETE", "cor": "azul", "em": "repete." }
      ]
