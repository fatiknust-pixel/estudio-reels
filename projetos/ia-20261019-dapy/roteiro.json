        { "tipo": "icones", "itens": [["celular", "BOM"], ["seta", ""], ["balao", "DIA"]], "em": "autocompletar", "posicao": "meio" },
        { "tipo": "placar", "sim": 100, "nao": 5, "rotulo": "CONTEXTO LIDO", "rotuloSim": "LLM: CONVERSA INTEIRA", "rotuloNao": "CELULAR: ÚLTIMA PALAVRA", "em": "milhões", "posicao": "alto" },
        { "tipo": "carimbo", "texto": "MUITO MAIS CONTEXTO", "cor": "verde", "em": "inteira," }
      ]
    },
    {
      "id": "exemplo",
      "texto": "Em junho de 2017, pesquisadores do Google publicaram o artigo Attention Is All You Need, que criou o Transformer. A ideia central é a atenção: o modelo pesa quais palavras importam mais. Veja a frase: a chave caiu no rio. A atenção liga chave a rio, e entende que não é de porta.",
      "fundo": "google",
      "fontes": ["Vaswani et al., arXiv 1706.03762 — jun/2017"],
      "elementos": [
        { "tipo": "titulo", "texto": "O TRANSFORMER", "sub": "GOOGLE · 2017", "em": 0, "posicao": "topo" },
        { "tipo": "linha", "itens": [["2017", "TRANSFORMER"], ["HOJE", "BASE DOS LLMs"]], "em": "junho", "posicao": "alto" },
        { "tipo": "definicao", "palavra": "ATENÇÃO", "significado": "o modelo pesa quais palavras importam mais", "em": "atenção:", "posicao": "alto2" },
        { "tipo": "comentario", "texto": "a chave caiu no rio", "em": "Veja", "posicao": "meio" },
        { "tipo": "carimbo", "texto": "CHAVE ↔ RIO", "cor": "amarelo", "em": "liga" }
      ]
    },
    {
      "id": "treino",
      "texto": "Primeiro vem o pré-treino: o modelo lê muito texto e aprende a prever o que vem depois. Depois vem o ajuste fino, com feedback de pessoas e de outra IA. Em dezembro de 2022, a Anthropic apresentou a IA Constitucional: o modelo segue princípios escritos.",
      "fundo": "anthropic",
      "fontes": ["Anthropic — Constitutional AI, dez/2022"],
      "elementos": [
        { "tipo": "titulo", "texto": "COMO ELE É TREINADO", "em": 0, "posicao": "topo" },
        { "tipo": "icones", "itens": [["documento", "PRÉ-TREINO"], ["seta", ""], ["check", "AJUSTE FINO"]], "em": "Primeiro", "posicao": "alto" },
        { "tipo": "tag", "texto": "MUITO TEXTO", "icone": "documento", "cor": "azul", "em": "muito", "posicao": "meio" },
        { "tipo": "tag", "texto": "FEEDBACK HUMANO + IA", "icone": "balao", "cor": "verde", "em": "feedback", "posicao": "meio" },
        { "tipo": "definicao", "palavra": "IA CONSTITUCIONAL", "significado": "o modelo segue princípios escritos", "em": "Constitucional:", "posicao": "alto2" }
      ]
    },
    {
      "id": "erro-comum",
      "texto": "O erro comum é achar que o modelo consulta um banco de respostas prontas. Não consulta. Ele gera cada token com base em padrões, por isso pode errar com confiança.",
      "elementos": [
        { "tipo": "carimbo", "texto": "ERRO COMUM", "cor": "vermelho", "em": 0 },
        { "tipo": "check", "ok": false, "texto": "Busca respostas prontas", "nota": "Ele gera token por token", "em": "consulta", "posicao": "meio" },
        { "tipo": "check", "ok": true, "texto": "Gera com base em padrões", "nota": "por isso pode errar", "em": "gera", "posicao": "meio2" },
        { "tipo": "tag", "texto": "ERRA COM CONFIANÇA", "icone": "alerta", "cor": "vermelho", "em": "errar", "posicao": "alto" }
      ]
    },
    {
      "id": "pratica",
      "texto": "Pause o vídeo e tente: digite uma frase incompleta no seu celular e veja o que o autocompletar sugere.",
