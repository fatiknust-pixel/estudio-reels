        { "tipo": "comentario", "texto": "hoje eu vou...", "em": "frase", "posicao": "alto" },
        { "tipo": "pergunta", "texto": "O QUE ELE SUGERE?", "em": "autocompletar", "posicao": "meio" }
      ]
    },
    {
      "id": "resumo",
      "texto": "Resumo. Um LLM prevê o próximo token. O Transformer usa atenção para entender o contexto. E o treino tem duas etapas: pré-treino e ajuste fino.",
      "elementos": [
        { "tipo": "titulo", "texto": "RESUMO", "em": 0, "posicao": "topo" },
