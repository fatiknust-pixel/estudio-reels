        { "tipo": "carimbo", "texto": "RISCO Nº 1", "cor": "vermelho", "em": "lidera", "posicao": "meio2" },
        { "tipo": "titulo", "texto": "PROMPT INJECTION", "em": "prompt", "posicao": "topo" }
      ]
    },
    {
      "id": "promessa",
      "texto": "Na aula 4.5, você vai aprender como o ataque funciona, por que ele é o risco número um e três defesas simples.",
